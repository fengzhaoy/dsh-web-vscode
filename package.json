{
  "name": "@zhaoyang10/dsh-web-vscode",
  "version": "0.1.0",
  "description": "VS Code tab for the dsh web client: an embedded code-server workbench opened as a conversation view tab and in the right sidebar.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": "./lib/typert.host.js",
    "./remote": "./lib/typert.remote-client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-files",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    },
    "env": {
      "minVersion": "0.2.0-rc.2"
    }
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "dsh": ">=0.2.0-rc.2"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "@deepseek-ai/cordis": ">=4.0.0 <5.0.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.1 <0.2.0 || >=0.2.0-rc.2 <0.2.1 || >=0.2.1-rc.1 <0.2.2 || >=0.2.2-rc.1 <0.2.3 || >=0.2.3-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-subprocess": ">=0.2.0-rc.1 <0.2.0 || >=0.2.0-rc.2 <0.2.1 || >=0.2.1-rc.1 <0.2.2 || >=0.2.2-rc.1 <0.2.3 || >=0.2.3-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.0-rc.1 <0.2.0 || >=0.2.0-rc.2 <0.2.1 || >=0.2.1-rc.1 <0.2.2 || >=0.2.2-rc.1 <0.2.3 || >=0.2.3-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-util-values": ">=0.2.0-rc.1 <0.2.0 || >=0.2.0-rc.2 <0.2.1 || >=0.2.1-rc.1 <0.2.2 || >=0.2.2-rc.1 <0.2.3 || >=0.2.3-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.0 <4.0.0-0"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-subprocess": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-util-values": "^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.11.0",
    "typescript": "^5.6.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "screenshots.json"
  ],
  "scripts": {
    "bundle": "tsdown && node scripts/copy-extension.mjs",
    "build": "tsdown && node scripts/copy-extension.mjs",
    "watch": "tsdown --watch",
    "test": "node scripts/test-plugin.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fengzhaoy/dsh-web-vscode.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "client-plugin",
    "vscode",
    "code-server",
    "ide",
    "editor",
    "remote-development"
  ],
  "author": "fengzhaoy",
  "homepage": "https://github.com/fengzhaoy/dsh-web-vscode#readme",
  "bugs": {
    "url": "https://github.com/fengzhaoy/dsh-web-vscode/issues"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-subprocess": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    },
    "@deepseek-ai/dsh-util-values": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
